#include <windows.h>
#include <winuser.h>

// 1 is CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 is RT_MANIFEST
1 RT_MANIFEST "app.manifest"
100 ICON DISCARDABLE "main.ico"



// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION        1,0,0,67
PRODUCTVERSION     1,0,0,67
FILEFLAGSMASK      VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS          VS_FF_DEBUG
#else
FILEFLAGS          0x0L
#endif
FILEOS             VOS_NT_WINDOWS32
FILETYPE           VFT_APP
FILESUBTYPE        VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0" // US English (0x0409), Unicode Charset (0x04B0 = 1200)
        BEGIN
            VALUE "FileDescription",  "Codepad Lightweight Syntax Editor"
            VALUE "FileVersion",      "1.0.0.67"
            VALUE "InternalName",     "Codepad"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "Codepad.exe"
            VALUE "ProductName",      "Codepad"
            VALUE "ProductVersion",   "1.0.067"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
